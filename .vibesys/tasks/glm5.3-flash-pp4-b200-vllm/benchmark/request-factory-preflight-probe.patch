+
+/// 32 hex digits from two randomly keyed SipHash instances, keyed once per
+/// process: stable for one id within a run, unpredictable across runs.
+fn opaque_wire_id(request_id: &str) -> String {
+    static KEYS: OnceLock<(RandomState, RandomState)> = OnceLock::new();
+    let (a, b) = KEYS.get_or_init(|| (RandomState::new(), RandomState::new()));
+    format!("{:016x}{:016x}", a.hash_one(request_id), b.hash_one(request_id))
+}
